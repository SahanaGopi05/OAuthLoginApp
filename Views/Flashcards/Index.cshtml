@{
    ViewData["Title"] = "Flashcards";
    var subjects = ViewBag.Subjects as List<string>;
    var selected = ViewBag.SelectedSubject as string;
    var flashcards = ViewBag.Flashcards as List<(string, string)>;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    body {
        background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
        font-family: 'Segoe UI', sans-serif;
        color: white;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
        margin-top: 20px;
    }

    .flashcard {
        background-color: #1e1e2f;
        width: 250px;
        height: 150px;
        border-radius: 15px;
        perspective: 1000px;
        cursor: pointer;
    }

    .inner {
        width: 100%;
        height: 100%;
        transition: transform 0.6s;
        transform-style: preserve-3d;
        position: relative;
    }

    .flashcard:hover .inner {
        transform: rotateY(180deg);
    }

    .front, .back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 15px;
    padding: 15px;
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
    display: flex;
    align-items: flex-start; /* Align text to the top */
    justify-content: center;
    font-weight: normal;
    text-align: left;
    font-size: clamp(0.85rem, 1.8vw, 1rem); /* 👈 Place it here */
    line-height: 1.4;
    overflow-y: auto;
    word-wrap: break-word;
    overflow-wrap: break-word;
    white-space: normal;
    scrollbar-width: thin;
    }


    .front {
        background-color: #2a2a3f;
    }

    .back {
        background-color: #007bff;
        transform: rotateY(180deg);
    }

    .dropdown-section {
        text-align: center;
        margin-top: 30px;
    }

    .back-btn {
        position: absolute;
        top: 20px;
        left: 20px;
    }

    .back-btn a {
        background-color: #ff6b6b;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: bold;
    }

    .back-btn a:hover {
        background-color: #e65050;
    }
</style>


<div class="dropdown-section">
    <h2>🧠 Flashcards</h2>
    <form method="get">
        <label for="subject">Choose a subject:</label>
        <select name="subject" id="subject" onchange="this.form.submit()" class="form-select w-50 d-inline-block mt-3 rounded-4">
            @{
                if (string.IsNullOrEmpty(selected))
                {
                    <text><option disabled selected>Select subject</option></text>
                }
                else
                {
                    <text><option disabled>Select subject</option></text>
                }

                foreach (var subject in subjects)
                {
                    if (subject == selected)
                    {
                        <text><option value="@subject" selected>@subject</option></text>
                    }
                    else
                    {
                        <text><option value="@subject">@subject</option></text>
                    }
                }
            }
        </select>
    </form>

    <div class="mt-4">
        <a href="/Home/Dashboard" class="btn btn-outline-light btn-custom px-4 py-2">🏠 Return to Dashboard</a>
    </div>

</div>

@if (flashcards != null && flashcards.Count > 0)
{
    <div class="card-container">
        @foreach (var (q, a) in flashcards)
        {
            <div class="flashcard">
                <div class="inner">
                    <div class="front">@q</div>
                    <div class="back">@a</div>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(selected))
{
    <p class="text-center mt-5">No flashcards available for <strong>@selected</strong>.</p>
}

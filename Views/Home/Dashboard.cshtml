@{
    ViewData["Title"] = "Dashboard";
    var userName = ViewBag.UserName ?? "User";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
        color: white;
    }

    .dashboard-container {
        max-width: 1100px;
        margin: 60px auto;
        text-align: center;
        padding: 30px;
    }

    .dashboard-title {
        font-size: 2.5rem;
        margin-bottom: 40px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 30px;
    }

    .card-option {
        padding: 25px;
        border-radius: 20px;
        background-color: #2e3b4e;
        box-shadow: 0 0 15px rgba(0,0,0,0.4);
        transition: transform 0.2s ease, background 0.3s ease;
        text-decoration: none;
        color: white;
    }

        .card-option:hover {
            transform: translateY(-6px);
            background-color: #3f4f66;
        }

    .icon {
        font-size: 40px;
        margin-bottom: 10px;
        color: #ffffff;
    }

    .label {
        font-size: 1.2rem;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 50px;
        background: rgba(0, 0, 0, 0.4);
    }

    .logout-btn {
        background: transparent;
        border: 1px solid white;
        color: white;
        padding: 8px 15px;
        border-radius: 8px;
        text-decoration: none;
    }

        .logout-btn:hover {
            background-color: #ff4d4d;
            color: white;
            border: none;
        }
</style>

<div class="top-bar">
    <div><strong>Hi, @userName 👋</strong></div>
    <div>
        @if (User.Identity.IsAuthenticated)
        {
            <a href="/account/logout" class="logout-btn">Logout</a>
        }
        else
        {
            <a href="/account/login" class="logout-btn">Login</a>
        }
    </div>
</div>

<div class="dashboard-container">
    <div class="dashboard-title">Welcome to Your Study Portal</div>

    <div class="grid">
        <a href="/Upload/Index" class="card-option">
            <div class="icon"><i class="fas fa-upload"></i></div>
            <div class="label">Upload Materials</div>
        </a>
        <a href="/Flashcards" class="card-option">
            <div class="icon"><i class="fas fa-clone"></i></div>
            <div class="label">Flashcards</div>
        </a>
        <a href="/Quiz/Index" class="card-option">
            <div class="icon"><i class="fas fa-question-circle"></i></div>
            <div class="label">Attempt Quiz</div>
        </a>
        <a href="/TestResult/Index" class="card-option">
            <div class="icon"><i class="fas fa-chart-bar"></i></div>
            <div class="label">Test Results</div>
        </a>
    </div>
</div>

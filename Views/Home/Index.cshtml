@{
    ViewData["Title"] = "Home Page";
}

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
        color: white;
        min-height: 100vh;
    }

    .main-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 60px 20px;
        min-height: calc(100vh - 80px);
    }

        .main-content h1 {
            font-size: 3rem;
            margin-bottom: 20px;
            margin-top: -60px;
            letter-spacing: 1px;
        }

        .main-content p {
            font-size: 1.2rem;
            max-width: 600px;
            line-height: 1.6;
            color: #dcdcdc;
            font-family: 'Georgia', serif;
            font-style: italic;
            margin-bottom: 30px;
        }

    .login-buttons {
        display: flex;
        gap: 20px;
    }

    .login-button {
        padding: 12px 28px;
        background-color: transparent;
        border: 1px solid white;
        border-radius: 30px;
        font-size: 1rem;
        color: white;
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .login-button:hover {
            background-color: #ff4d4d;
            color: white;
            border: none;
        }
</style>

<div class="main-content">
    <h1>Welcome to LearnMate</h1>
    <p>
        A simple, intelligent tool to transform your study materials into flashcards and quizzes.<br />
        Upload content, learn smart, and stay ahead — all powered by AI.
    </p>

    <div class="login-buttons">
        
        <a class="login-button" href="/Account/ExternalLogin?role=Student">Login </a>
    </div>
</div>

@{
    ViewData["Title"] = "Access Denied";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
        color: white;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .message-box {
        max-width: 600px;
        padding: 40px;
        border-radius: 15px;
        background-color: rgba(0,0,0,0.3);
        box-shadow: 0 0 15px rgba(0,0,0,0.5);
    }

        .message-box h1 {
            font-size: 3rem;
            color: #ff4d4d;
            margin-bottom: 20px;
        }

        .message-box p {
            font-size: 1.2rem;
            color: #dcdcdc;
            margin-bottom: 30px;
        }

    .btn-home {
        padding: 10px 20px;
        background-color: transparent;
        border: 1px solid white;
        border-radius: 30px;
        font-size: 1rem;
        color: white;
        text-decoration: none;
        transition: background-color 0.3s ease;
    }

        .btn-home:hover {
            background-color: #ff4d4d;
            color: white;
            border: none;
        }
</style>

<div class="message-box">
    <h2>🚫 Access Denied</h2>
    <p>Only Admins are allowed to access this page.<br />Please return to the Dashboard or contact an administrator.</p>
    <a class="btn-home" href="/Home/Dashboard">Back to Dashboard</a>
</div>

@{
    ViewData["Title"] = "Upload Materials";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
        color: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .card {
        background-color: #1e1e2f;
        border: none;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 0 15px rgba(0,0,0,0.3);
    }

    .btn-custom {
        border-radius: 15px;
        font-weight: 500;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card text-white">
                <h3 class="text-center mb-4">📤 Upload Study Material</h3>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success text-center rounded-4 shadow-sm">
                        @Html.Raw(ViewBag.Message)
                    </div>
                }

                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Subject Name</label>
                        <input type="text" name="subject" class="form-control rounded-4" required placeholder="e.g., Mathematics">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Choose File</label>
                        <input type="file" name="file" class="form-control rounded-4" required>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-success btn-custom px-4 py-2">Upload</button>
                    </div>
                </form>

                <!-- ✅ Fixed Return to Dashboard Button -->
                <div class="text-center mt-4">
                    <a href="/Home/Dashboard" class="btn btn-outline-light btn-custom px-4 py-2">🏠 Return to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
